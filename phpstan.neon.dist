parameters:
  fileExtensions:
    - php
    - phpt
  universalObjectCratesClasses:
    # Why: Pest annotates the $this inside test/beforeEach closures as TestCall,
    # but TestCall is not in Pest's own universalObjectCratesClasses. Tests use
    # the documented pattern of setting fixtures on $this in beforeEach and
    # reading them in tests, so treat TestCall as a property bag.
    - Pest\PendingCalls\TestCall
  ignoreErrors:
    -
      # Why: SimpleXMLElement is weird and doesn't implement anything ArrayAccess-like
      message: '/Instanceof between mixed and SimpleXMLElement will always evaluate to false\./'
      path: src/Validators/ArrayVal.php
    - message: '/Call to an undefined method .+::expectException\(\)/'
      path: tests/Pest.php
    - message: '/Undefined variable: \$this/'
      path: tests/feature/Validators/SizeTest.php
    - message: '/Undefined variable: \$this/'
      path: tests/Pest.php
    - message: '/Method .+\\TestingHandler::handle\(\) never returns null so it can be removed from the return type./'
      path: tests/src/Message/TestingHandler.php
    - message: '/Property Respect\\Validation\\Test\\Stubs\\.+::\$[a-zA-Z]+ is never read, only written./'
      path: tests/src/Stubs
    # Why: Coverage stubs intentionally reference non-existent classes
    # (UnknownClass, UnknownOne, UnknownTwo, NonExistentClass) to exercise the
    # DocblockPropertyResolver branches that handle unresolvable types.
    - message: '/Property Respect\\Validation\\Test\\Stubs\\.+ has unknown class Respect\\Validation\\Test\\Stubs\\(UnknownClass|UnknownOne|UnknownTwo|NonExistentClass|Collection) as its type\./'
      path: tests/src/Stubs
    # Why: Coverage stubs intentionally use @var without a type and with
    # unresolvable generic arguments to exercise parseVarType()/resolveArrayGeneric().
    - message: '/PHPDoc tag @var has invalid value \(\): Unexpected token/'
      path: tests/src/Stubs/WithVarWithoutTypeProperty.php
    - message: '/PHPDoc tag @var for property .+ contains unresolvable type\./'
      path: tests/src/Stubs
    - message: '/PHPDoc tag @var for property .+ with type mixed is not subtype of native type array\./'
      path: tests/src/Stubs
    - message: '/Property .+ type has no value type specified in iterable type array\./'
      path: tests/src/Stubs
  level: 8
  treatPhpDocTypesAsCertain: false
  paths:
    - src/
    - tests/
